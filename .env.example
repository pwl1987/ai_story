# ============================================
# AI Story - 生产环境变量配置示例
# ============================================
# 使用方法:
#   1. 复制此文件为 .env: cp .env.example .env
#   2. 修改所有标记为 [REQUIRED] 的变量
#   3. 根据需要调整其他变量
#   4. 确保 .env 文件不会被提交到Git仓库
# ============================================

# ============================================
# Django 基础配置
# ============================================
# Django密钥 (必需, 生成方法: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=[REQUIRED]

# 调试模式 (生产环境必须设置为 False)
DEBUG=False

# 允许的主机 (逗号分隔, 生产环境需配置实际域名)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ============================================
# 数据库配置 (PostgreSQL)
# ============================================
POSTGRES_DB=ai_story
POSTGRES_USER=ai_story
POSTGRES_PASSWORD=[REQUIRED]  # 生成强密码
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============================================
# Redis 配置
# ============================================
REDIS_PASSWORD=[REQUIRED]  # 生成强密码
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================
# Celery 配置
# ============================================
# Celery Broker URL (Redis)
CELERY_BROKER_URL=redis://:[REDIS_PASSWORD]@redis:6379/0

# Celery Result Backend (Redis)
CELERY_RESULT_BACKEND=redis://:[REDIS_PASSWORD]@redis:6379/1

# ============================================
# AI 服务配置
# ============================================
# OpenAI API Key (用于GPT模型)
OPENAI_API_KEY=[OPTIONAL]

# Anthropic API Key (用于Claude模型)
ANTHROPIC_API_KEY=[OPTIONAL]

# 其他AI服务API端点
STABLE_DIFFUSION_API_URL=
RUNWAY_API_URL=
COMFYUI_API_URL=

# ============================================
# CORS 配置
# ============================================
# 允许的跨域来源 (逗号分隔)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,https://yourdomain.com

# ============================================
# 媒体存储配置
# ============================================
# 存储根目录
STORAGE_ROOT=/app/media

# 最大上传大小 (MB)
MAX_UPLOAD_SIZE=100

# ============================================
# 日志配置
# ============================================
# 日志级别 (DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_LEVEL=INFO

# 日志格式 (json/text)
LOG_FORMAT=json

# ============================================
# 端口配置
# ============================================
# Nginx HTTP端口
NGINX_HTTP_PORT=80

# Nginx HTTPS端口
NGINX_HTTPS_PORT=443

# Django Backend端口
BACKEND_PORT=8000

# PostgreSQL端口
POSTGRES_PORT=5432

# Redis端口
REDIS_PORT=6379

# ============================================
# SSL/TLS 配置 (生产环境)
# ============================================
# SSL证书路径 (Let's Encrypt或自签名)
SSL_CERT_PATH=./deploy/nginx/ssl/cert.pem
SSL_KEY_PATH=./deploy/nginx/ssl/key.pem

# 强制HTTPS (生产环境建议启用)
FORCE_HTTPS=True

# ============================================
# 监控和告警 (可选)
# ============================================
# Sentry DSN (错误追踪)
SENTRY_DSN=

# 监控端点
HEALTHCHECK_ENABLED=True

# ============================================
# 性能优化
# ============================================
# 数据库连接池大小
DB_POOL_SIZE=20

# Celery Worker并发数
CELERY_WORKER_CONCURRENCY=4

# 缓存超时时间(秒)
CACHE_TIMEOUT=3600
