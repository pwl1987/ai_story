# API配置
VUE_APP_API_BASE_URL=http://localhost:8000/api/v1
VUE_APP_WS_URL=ws://localhost:8000

# 应用配置
VUE_APP_TITLE=AI Story
VUE_APP_ENV=development

# 功能开关
VUE_APP_ENABLE_WEBSOCKET=true
VUE_APP_ENABLE_MOCK=false

# 上传配置
VUE_APP_MAX_FILE_SIZE=10485760
VUE_APP_ALLOWED_FILE_TYPES=.jpg,.jpeg,.png,.gif,.mp4
