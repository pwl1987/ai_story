# Django配置
SECRET_KEY=change-this-to-a-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库配置
# 开发环境使用SQLite,生产环境使用PostgreSQL
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_story

# Redis配置 (5个数据库分离架构)
# 数据库0: Celery任务队列
REDIS_BROKER_URL=redis://localhost:6379/0
# 数据库1: Celery结果存储
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# 数据库2: Pub/Sub专用(实时进度推送)
REDIS_PUBSUB_URL=redis://localhost:6379/2
# 数据库3: Django Channels专用
CHANNEL_LAYER_REDIS=redis://localhost:6379/3
# 数据库4: Django缓存
CACHE_REDIS=redis://localhost:6379/4

# AI API密钥 (至少配置一个)
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Celery配置
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json

# 应用配置
DJANGO_SETTINGS_MODULE=config.settings.development

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/django.log
